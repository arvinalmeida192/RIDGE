<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RIDGE</title>
  <link rel="stylesheet" href="/css/ridge.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script defer src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body class="topo-bg">
<div class="admin-layout">
  <aside class="sidebar" style="display:flex;flex-direction:column">
    <div class="sidebar-logo">⛰ RIDGE</div>
    <nav>
      <a href="/dashboard" class="<%= title === 'Dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/alerts" class="<%= title === 'Alerts' ? 'active' : '' %>">Alerts</a>
      <a href="/analytics" class="<%= title === 'Analytics' ? 'active' : '' %>">Analytics</a>
      <a href="/admin" class="<%= title === 'Admin' ? 'active' : '' %>">Admin</a>
      <a href="/news" class="<%= title === 'News' ? 'active' : '' %>">News</a>
      <a href="/citizen">Citizen Portal</a>
      <a href="/logout" style="margin-top:2rem;color:#ef4444">Logout</a>
    </nav>
    <p class="ridge-credit">Developed by Los Gatos</p>
  </aside>
  <main class="main-content">
    <%- body %>
  </main>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script src="/js/ridge-map.js"></script>
<script src="/js/ridge-charts.js"></script>
<script src="/js/ridge-app.js"></script>
</body>
</html>
