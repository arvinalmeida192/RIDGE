<div class="login-page topo-bg">
  <div class="login-box glass-panel">
    <h1>⛰ RIDGE</h1>
    <p style="text-align:center;color:var(--ridge-muted);margin-bottom:1.5rem;font-size:0.875rem">
      Citizen Portal
    </p>

    <% if (error === 'invalid') { %>
    <div class="login-error">Invalid username or password</div>
    <% } else if (error === 'taken') { %>
    <div class="login-error">That username or email is already registered. Try signing in instead.</div>
    <% } else if (error === 'firebase') { %>
    <div class="login-error">Please sign in with your Firebase account below.</div>
    <% } %>

    <% if (authMode?.firebaseEnabled && firebaseConfig) { %>
    <div id="auth-message" class="form-message" style="display:none"></div>
    <button type="button" id="firebase-google" class="btn btn-google" style="width:100%;justify-content:center;margin-bottom:1rem">
      Continue with Google
    </button>
    <div class="login-divider"><span>or</span></div>
    <form id="firebase-form">
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="firebase-email" required autofocus placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="firebase-password" required placeholder="••••••" minlength="6">
      </div>
      <button type="submit" id="firebase-submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem">
        Sign In
      </button>
      <button type="button" id="firebase-signup" class="btn btn-ghost" style="width:100%;justify-content:center;margin-top:0.5rem">
        Create Account
      </button>
    </form>
    <p style="text-align:center;margin-top:1rem;font-size:0.75rem;color:var(--ridge-muted)">
      Want operations access? After signing in, apply from the Citizen Portal sidebar.
    </p>
    <% } else if (authMode?.legacyLoginEnabled) { %>
    <div class="login-tabs" role="tablist">
      <a href="/citizen/login?next=<%= encodeURIComponent(next) %>" class="login-tab<%= mode !== 'signup' ? ' active' : '' %>" role="tab">Sign In</a>
      <a href="/citizen/login?mode=signup&next=<%= encodeURIComponent(next) %>" class="login-tab<%= mode === 'signup' ? ' active' : '' %>" role="tab">Create Account</a>
    </div>

    <% if (mode === 'signup') { %>
    <form method="POST" action="/citizen/signup">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" required autofocus placeholder="your_username" pattern="[a-zA-Z0-9_]{3,50}" title="3–50 characters: letters, numbers, underscore">
      </div>
      <div class="form-group">
        <label>Email <span style="color:var(--ridge-muted)">(optional)</span></label>
        <input type="email" name="email" placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required placeholder="••••••" minlength="6">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem">
        Create Account
      </button>
    </form>
    <p style="text-align:center;margin-top:1rem;font-size:0.75rem;color:var(--ridge-muted)">
      Already have an account? <a href="/citizen/login?next=<%= encodeURIComponent(next) %>">Sign in</a>
    </p>
    <% } else { %>
    <form method="POST" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <input type="hidden" name="loginType" value="citizen">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" required autofocus placeholder="user">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required placeholder="••••••">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem">
        Sign In
      </button>
    </form>
    <p style="text-align:center;margin-top:1rem;font-size:0.75rem;color:var(--ridge-muted)">
      New here? <a href="/citizen/login?mode=signup&next=<%= encodeURIComponent(next) %>">Create an account</a>
      · Demo: <code>user</code> / <code>user</code>
    </p>
    <% } %>
    <% } else { %>
    <p style="text-align:center;color:var(--ridge-muted);font-size:0.875rem">
      Authentication is not configured. Contact your administrator.
    </p>
    <% } %>

    <p style="text-align:center;margin-top:1rem;font-size:0.75rem;color:var(--ridge-muted)">
      <a href="/">← Back to home</a> · <a href="/login">Operations Login</a>
    </p>
  </div>
</div>

<% if (authMode?.firebaseEnabled && firebaseConfig) { %>
<script>
  window.RIDGE_FIREBASE_CONFIG = <%- JSON.stringify(firebaseConfig) %>;
  window.RIDGE_LOGIN_TYPE = '<%= loginType %>';
  window.RIDGE_NEXT_URL = <%- JSON.stringify(next) %>;
  <% if (firebaseEmulator) { %>window.RIDGE_FIREBASE_EMULATOR = '<%= firebaseEmulator %>';<% } %>
</script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="/js/ridge-firebase-auth.js"></script>
<% } %>
