<div class="topbar">
  <div>
    <h1 class="page-title"><%= locale.nav_news %></h1>
    <p class="page-subtitle"><%= zone?.state %> · <%= locale.local_news %></p>
  </div>
</div>

<div style="display:flex;flex-direction:column;gap:1rem">
  <% if (!news.length) { %>
  <div class="glass-panel" style="padding:2rem;text-align:center;color:var(--ridge-muted)">
    <%= locale.no_news %>
  </div>
  <% } %>
  <% news.forEach(item => { %>
  <%- include('../partials/news-article', { item, linkLabel: locale.read_full_article }) %>
  <% }) %>
</div>
