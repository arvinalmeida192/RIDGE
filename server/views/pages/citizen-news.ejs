<div class="topbar">
  <div>
    <h1 class="page-title"><%= locale.nav_news %></h1>
    <p class="page-subtitle"><%= zone?.state %> · <%= locale.local_news %></p>
  </div>
</div>

<div style="display:flex;flex-direction:column;gap:1rem">
  <% if (!news.length) { %>
  <div class="glass-panel" style="padding:2rem;text-align:center;color:var(--ridge-muted)">
    <%= locale.no_news %>
  </div>
  <% } %>
  <% news.forEach(item => { %>
  <article class="glass-panel" style="padding:1.25rem">
    <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem">
      <span class="risk-badge risk-low" style="font-size:0.65rem"><%= item.tag %></span>
      <% if (item.state) { %><span style="font-size:0.75rem;color:var(--ridge-muted)"><%= item.state %></span><% } %>
    </div>
    <h2 style="font-size:1.1rem;margin-bottom:0.5rem"><%= item.title %></h2>
    <p style="color:var(--ridge-muted);font-size:0.875rem;line-height:1.5"><%= item.summary %></p>
    <div style="margin-top:0.75rem;font-size:0.75rem;color:var(--ridge-muted)">
      <%= item.source %> · <%= formatISTDate(item.timestamp) %>
    </div>
  </article>
  <% }) %>
</div>
