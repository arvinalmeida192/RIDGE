<div class="topbar">
  <div>
    <h1 class="page-title">Analytics</h1>
    <p class="page-subtitle">Risk trends, correlation analysis, and what-if scenarios</p>
  </div>
</div>

<!-- What-If Scenario -->
<div class="glass-panel" style="padding:1.5rem;margin-bottom:1.5rem" x-data="whatIfScenario()">
  <h3 style="margin-bottom:1rem">What-If Disaster Scenario</h3>
  <div class="grid-2" style="gap:1.5rem">
    <div>
      <% scenarioParams.forEach(p => { %>
      <div style="margin-bottom:1rem">
        <label style="font-size:0.8rem;color:var(--ridge-muted)">
          <%= p.label %>: <span x-text="params.<%= p.key %>"></span> <%= p.unit %>
        </label>
        <input type="range" min="<%= p.min %>" max="<%= p.max %>" step="<%= p.step %>"
               x-model.number="params.<%= p.key %>" @input="compute()" style="width:100%">
        <div style="display:flex;justify-content:space-between;font-size:0.7rem;color:var(--ridge-muted);margin-top:0.15rem">
          <span><%= p.min %> <%= p.unit %></span>
          <span><%= p.max %> <%= p.unit %></span>
        </div>
      </div>
      <% }) %>
      <button @click="reset()" class="btn btn-ghost" style="margin-top:0.5rem">Reset</button>
    </div>
    <div>
      <div class="grid-2" style="gap:0.75rem">
        <div class="glass-panel stat-card">
          <div class="stat-label">Regional Tier</div>
          <div class="stat-value" style="font-size:1.25rem" x-text="results?.regionalTier || '—'"></div>
        </div>
        <div class="glass-panel stat-card">
          <div class="stat-label">High+ Risk Zones</div>
          <div class="stat-value tabular-nums" x-text="(results?.simulatedHighRisk ?? '—') + ' / ' + (results?.baselineHighRisk ?? '—')"></div>
        </div>
        <div class="glass-panel stat-card">
          <div class="stat-label">Population at Risk</div>
          <div class="stat-value tabular-nums" x-text="results?.populationAtRisk != null ? results.populationAtRisk.toLocaleString('en-IN') + ' people' : '—'"></div>
        </div>
        <div class="glass-panel stat-card">
          <div class="stat-label">Pop. Delta</div>
          <div class="stat-value tabular-nums" x-text="results ? (results.populationDelta > 0 ? '+' : '') + results.populationDelta.toLocaleString('en-IN') + ' people' : '—'"></div>
        </div>
      </div>
      <template x-if="results?.activeConditions?.length">
        <div style="margin-top:1rem;font-size:0.8rem;color:var(--ridge-muted)">
          Active: <span x-text="results.activeConditions.join(', ')"></span>
        </div>
      </template>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="glass-panel" style="padding:1rem">
    <h3 style="margin-bottom:0.75rem">Risk Level Distribution</h3>
    <div class="chart-container">
      <canvas id="chart-analytics-pie" data-chart='<%= JSON.stringify(riskDist) %>'></canvas>
    </div>
  </div>
  <div class="glass-panel" style="padding:1rem">
    <h3 style="margin-bottom:0.75rem">Seasonal Risk Heatmap</h3>
    <div class="chart-container">
      <canvas id="chart-seasonal" data-chart='<%= JSON.stringify(seasonal) %>'></canvas>
    </div>
  </div>
</div>

<div class="glass-panel" style="padding:1rem;margin-top:1.5rem">
  <h3 style="margin-bottom:0.75rem">Rainfall–Risk Correlation by Zone</h3>
  <div class="chart-container" style="height:320px">
    <canvas id="chart-analytics-bar" data-chart='<%= JSON.stringify(rainfall) %>'></canvas>
  </div>
</div>

<script>
function whatIfScenario() {
  return {
    params: { rainfallMm: 0, earthquakeMagnitude: 0, soilMoisturePercent: 0, groundMovementMm: 0 },
    results: null,
    async compute() {
      const res = await fetch('/api/v1/scenarios/compute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(this.params),
      });
      if (res.ok) this.results = await res.json();
    },
    reset() {
      this.params = { rainfallMm: 0, earthquakeMagnitude: 0, soilMoisturePercent: 0, groundMovementMm: 0 };
      this.compute();
    },
    init() { this.compute(); }
  };
}

document.addEventListener('DOMContentLoaded', () => {
  RidgeCharts.riskPie('chart-analytics-pie');
  RidgeCharts.seasonalHeatmap('chart-seasonal');
  RidgeCharts.rainfallBar('chart-analytics-bar');
});
</script>
