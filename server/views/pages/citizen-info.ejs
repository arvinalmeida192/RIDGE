<div class="topbar">
  <div>
    <h1 class="page-title"><%= locale.nav_info %></h1>
    <p class="page-subtitle"><%= locale.info_subtitle %></p>
  </div>
</div>

<div class="glass-panel" style="padding:1.5rem;margin-bottom:1.5rem">
  <h3 style="margin-bottom:0.75rem;color:var(--risk-low)"><%= locale.info_what_title %></h3>
  <p style="color:var(--ridge-muted);font-size:0.9rem;line-height:1.7"><%= locale.info_what_body %></p>
</div>

<div class="grid-2" style="margin-bottom:1.5rem">
  <div class="glass-panel" style="padding:1.5rem">
    <h3 style="margin-bottom:0.75rem;color:var(--risk-low)"><%= locale.info_why_title %></h3>
    <p style="color:var(--ridge-muted);font-size:0.875rem;line-height:1.7;margin-bottom:0.75rem"><%= locale.info_why_body %></p>
    <ul class="guidance-list">
      <li><%= locale.info_why_1 %></li>
      <li><%= locale.info_why_2 %></li>
      <li><%= locale.info_why_3 %></li>
      <li><%= locale.info_why_4 %></li>
    </ul>
  </div>

  <div class="glass-panel" style="padding:1.5rem">
    <h3 style="margin-bottom:0.75rem;color:var(--risk-moderate)"><%= locale.info_signs_title %></h3>
    <ul class="guidance-list">
      <li><%= locale.info_sign_1 %></li>
      <li><%= locale.info_sign_2 %></li>
      <li><%= locale.info_sign_3 %></li>
      <li><%= locale.info_sign_4 %></li>
      <li><%= locale.info_sign_5 %></li>
      <li><%= locale.info_sign_6 %></li>
    </ul>
  </div>
</div>

<div class="glass-panel" style="padding:1.5rem;margin-bottom:1.5rem">
  <h3 style="margin-bottom:1rem;color:var(--risk-low)"><%= locale.info_tiers_title %></h3>
  <div class="grid-3" style="gap:1rem">
    <div class="subscription-card">
      <span class="risk-badge risk-low" style="margin-bottom:0.5rem"><%= locale.info_tier_advisory %></span>
      <p style="font-size:0.85rem;color:var(--ridge-muted);line-height:1.6"><%= locale.info_tier_advisory_desc %></p>
    </div>
    <div class="subscription-card" style="background:rgba(253,224,71,0.05);border-color:rgba(253,224,71,0.2)">
      <span class="risk-badge risk-moderate" style="margin-bottom:0.5rem"><%= locale.info_tier_watch %></span>
      <p style="font-size:0.85rem;color:var(--ridge-muted);line-height:1.6"><%= locale.info_tier_watch_desc %></p>
    </div>
    <div class="subscription-card" style="background:rgba(255,17,85,0.05);border-color:rgba(255,17,85,0.2)">
      <span class="risk-badge risk-critical" style="margin-bottom:0.5rem"><%= locale.info_tier_warning %></span>
      <p style="font-size:0.85rem;color:var(--ridge-muted);line-height:1.6"><%= locale.info_tier_warning_desc %></p>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="glass-panel" style="padding:1.5rem">
    <h3 style="margin-bottom:0.75rem;color:var(--risk-low)"><%= locale.info_before_title %></h3>
    <ul class="guidance-list numbered">
      <li><%= locale.info_before_1 %></li>
      <li><%= locale.info_before_2 %></li>
      <li><%= locale.info_before_3 %></li>
      <li><%= locale.info_before_4 %></li>
    </ul>
  </div>

  <div class="glass-panel" style="padding:1.5rem">
    <h3 style="margin-bottom:0.75rem;color:var(--risk-critical)"><%= locale.info_during_title %></h3>
    <ul class="guidance-list numbered">
      <li><%= locale.info_during_1 %></li>
      <li><%= locale.info_during_2 %></li>
      <li><%= locale.info_during_3 %></li>
      <li><%= locale.info_during_4 %></li>
    </ul>
  </div>
</div>

<div class="glass-panel" style="padding:1.5rem;margin-top:1.5rem">
  <h3 style="margin-bottom:0.75rem;color:var(--risk-low)"><%= locale.info_after_title %></h3>
  <ul class="guidance-list">
    <li><%= locale.info_after_1 %></li>
    <li><%= locale.info_after_2 %></li>
    <li><%= locale.info_after_3 %></li>
  </ul>
  <p style="margin-top:1rem;font-size:0.85rem;color:var(--ridge-muted)"><%= locale.info_help_line %></p>
</div>
