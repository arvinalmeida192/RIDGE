<div class="topbar">
  <div>
    <a href="/dashboard" style="font-size:0.8rem;color:var(--ridge-muted)">← Dashboard</a>
    <h1 class="page-title"><%= zone.name %></h1>
    <p class="page-subtitle"><%= zone.state %> · <%= zone.id %></p>
  </div>
  <span class="risk-badge risk-<%= (zone.riskLevel || 'low').toLowerCase().replace(' ', '-') %>"><%= zone.riskLevel %></span>
</div>

<div class="grid-4" style="margin-bottom:1.5rem">
  <div class="glass-panel stat-card">
    <div class="stat-label">Risk Score</div>
    <div class="stat-value tabular-nums"><%= zone.riskScore?.toFixed(1) ?? '—' %> <span style="font-size:0.85rem">/ 5</span></div>
  </div>
  <div class="glass-panel stat-card">
    <div class="stat-label">24h Rainfall</div>
    <div class="stat-value tabular-nums"><%= zone.rainfall24h ?? 0 %> mm</div>
  </div>
  <div class="glass-panel stat-card">
    <div class="stat-label">Soil Saturation</div>
    <div class="stat-value tabular-nums"><%= zone.soilSaturation ?? 0 %>%</div>
  </div>
  <div class="glass-panel stat-card">
    <div class="stat-label">Elevation</div>
    <div class="stat-value tabular-nums"><%= zone.elevation ?? '—' %> m</div>
  </div>
</div>

<div class="grid-main-side">
  <div class="glass-panel" style="padding:1rem">
    <h3 style="margin-bottom:0.75rem">24-Hour Risk Trajectory</h3>
    <div class="chart-container" style="height:300px">
      <canvas id="chart-trajectory"
        data-trajectory='<%= JSON.stringify(zone.forecastTrajectory || []) %>'></canvas>
    </div>
  </div>

  <div>
    <div class="glass-panel" style="padding:1rem;margin-bottom:1rem">
      <h3 style="margin-bottom:0.75rem">Causative Factors</h3>
      <% if (zone.causativeFactors?.length) { %>
        <% zone.causativeFactors.forEach(f => { %>
        <div class="factor-bar">
          <div class="factor-bar-label">
            <span><%= f.factor %></span>
            <span><%= f.contributionPercent %>%</span>
          </div>
          <div class="factor-bar-track">
            <div class="factor-bar-fill" style="width:<%= f.contributionPercent %>%"></div>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <p style="color:var(--ridge-muted);font-size:0.875rem">No factor data available</p>
      <% } %>
    </div>

    <% if (zone.exposure) { %>
    <div class="glass-panel" style="padding:1rem">
      <h3 style="margin-bottom:0.75rem">Exposure Assessment</h3>
      <p style="font-size:0.8rem;color:var(--ridge-muted);margin-bottom:0.5rem"><%= zone.exposure.exposureSummary %></p>
      <div class="grid-2" style="gap:0.5rem">
        <div><span class="stat-label">Population</span><div class="tabular-nums"><%= zone.exposure.estimatedPopulationInRadius?.toLocaleString('en-IN') %></div></div>
        <div><span class="stat-label">Severity</span><div><%= zone.exposure.severityTier %></div></div>
        <div><span class="stat-label">Roads at risk</span><div><%= zone.exposure.roadNetworkLengthAtRiskKm %> km</div></div>
        <div><span class="stat-label">Structures</span><div><%= zone.exposure.estimatedStructuresAtRisk %></div></div>
      </div>
    </div>
    <% } %>
  </div>
</div>

<% if (zone.historicalIncidents?.length) { %>
<div class="glass-panel" style="padding:1rem;margin-top:1.5rem">
  <h3 style="margin-bottom:0.75rem">Historical Incidents</h3>
  <table class="data-table">
    <thead><tr><th>Date</th><th>Event</th><th>Severity</th></tr></thead>
    <tbody>
      <% zone.historicalIncidents.forEach(inc => { %>
      <tr>
        <td><%= formatISTDate(inc.date) %></td>
        <td><%= inc.event %></td>
        <td><%= inc.severity %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    RidgeCharts.trajectory('chart-trajectory');
  });
</script>
