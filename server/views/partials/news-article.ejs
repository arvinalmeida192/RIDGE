<article class="glass-panel" style="padding:1.25rem">
  <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem;flex-wrap:wrap">
    <span class="risk-badge risk-low" style="font-size:0.65rem"><%= item.tag %></span>
    <% if (item.state) { %><span style="font-size:0.75rem;color:var(--ridge-muted)"><%= item.state %></span><% } %>
    <% if (item.zone) { %><span style="font-size:0.75rem;color:var(--ridge-muted)">· <%= item.zone %></span><% } %>
  </div>
  <% if (item.url) { %>
  <h2 style="font-size:1.1rem;margin-bottom:0.5rem">
    <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none">
      <%= item.title %>
    </a>
  </h2>
  <% } else { %>
  <h2 style="font-size:1.1rem;margin-bottom:0.5rem"><%= item.title %></h2>
  <% } %>
  <p style="color:var(--ridge-muted);font-size:0.875rem;line-height:1.5"><%= item.summary %></p>
  <div style="margin-top:0.75rem;display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap">
    <span style="font-size:0.75rem;color:var(--ridge-muted)">
      <%= item.source %> · <%= formatISTDate(item.timestamp) %>
    </span>
    <% if (item.url) { %>
    <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-ghost" style="font-size:0.75rem;padding:0.35rem 0.75rem">
      <%= linkLabel || 'Read full article →' %>
    </a>
    <% } %>
  </div>
</article>
