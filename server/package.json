{
  "name": "ridge-server",
  "version": "1.0.0",
  "description": "RIDGE landslide early-warning API server",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/seed_from_prototype.js",
    "seed:force": "node src/db/seeds/seed_from_prototype.js --force",
    "db:setup": "npm run migrate && npm run seed",
    "ingest:rainfall": "node -e \"import('./src/workers/ingestRainfall.js').then(m=>m.default())\"",
    "ingest:forecast": "node -e \"import('./src/workers/ingestForecast.js').then(m=>m.default())\"",
    "ingest:all": "node -e \"import('./src/scheduler.js').then(m=>m.runInitialIngestion())\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/api",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
