# Server
NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Database
DB_PASSWORD=ridge_dev_password
DATABASE_URL=postgresql://ridge:ridge_dev_password@localhost:5432/ridge

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# Auto-run on server start (development)
DB_MIGRATE_ON_START=true
DB_SEED_ON_START=true

# ML Service (Phase 3)
ML_SERVICE_URL=http://localhost:8000
SCORING_ENABLED=true
SCORING_ON_START=true

# Alert Engine (Phase 4)
ALERTS_ENABLED=true
NOTIFICATIONS_ENABLED=true
ALERT_COOLDOWN_MIN=60
AUTHORITY_ALERT_EMAIL=

# Production
CORS_ORIGINS=
HTTP_PORT=80

# Firebase Authentication (set FIREBASE_PROJECT_ID to enable; legacy login used when unset)
# Enable Email/Password + Google providers in Firebase Console → Authentication → Sign-in method
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# JSON string of service account key (required for token verification in production)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or path to service account JSON file (relative to project root)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Comma-separated emails that become admin on first Firebase sign-in
FIREBASE_BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Optional: localhost:9099 for Firebase Auth emulator
FIREBASE_AUTH_EMULATOR_HOST=
# Keep username/password login when Firebase is enabled (dev only)
LEGACY_LOGIN_ENABLED=false

# Notifications (Phase 4)
SMS_PROVIDER=msg91
MSG91_API_KEY=
MSG91_SENDER_ID=RIDGE

# Map tiles (Leaflet) — no API key needed with the default OpenStreetMap tiles below.
# Optional: use Mapbox dark tiles (requires free account + access token):
# MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token=YOUR_TOKEN
# MAP_TILE_ATTRIBUTION=&copy; Mapbox &copy; OpenStreetMap
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# Ingestion (Phase 2)
INGESTION_ENABLED=true
INGESTION_ON_START=true
INGESTION_OSM_ON_START=false
INGESTION_HISTORICAL_ON_START=false
INGESTION_INTERVAL_MIN=15
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
HISTORICAL_YEARS=2
